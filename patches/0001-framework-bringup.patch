+// An instruction the interpreter decodes but does not simulate still has to
+// retire. Leaving the pc on it makes the dispatcher re-enter the same address
+// forever, which looks like a hang and hides everything that comes after it.
+// Each distinct encoding is reported once so the missing set stays visible.
+constexpr std::size_t kMaxRetiredForms = 128u;
+std::unordered_map<std::uint32_t, std::uint32_t> g_retired_instructions;
+
+void note_retired_instruction(std::uint32_t pc, std::uint32_t word, const std::string &mnemonic) {
+    if (g_retired_instructions.size() >= kMaxRetiredForms) return;
+    if (!g_retired_instructions.emplace(word, pc).second) return;
+    std::cerr << "[interpreter] not simulated: " << mnemonic << " " << hex32(word) << " at " << hex32(pc) << "\n";
+}
